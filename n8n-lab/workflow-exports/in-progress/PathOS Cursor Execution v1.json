    {
      "parameters": {
        "jsCode": "const raw = $(\"Validate Run State\").item.json;\nconst runId = $(\"Normalize Cursor Packet\").item.json.runId;\n\nlet parsed = {};\nconst rawStdout = typeof raw.stdout === \"string\" ? raw.stdout : \"\";\nconst rawStderr = typeof raw.stderr === \"string\" ? raw.stderr : \"\";\nconst rawError = typeof raw.error === \"string\" ? raw.error : \"\";\nconst output = String(rawStdout || rawStderr).trim().replace(/^\\uFEFF/, \"\");\ntry {\n  const i = output.indexOf(\"{\");\n  const j = output.lastIndexOf(\"}\");\n  if (i !== -1 && j > i) {\n    parsed = JSON.parse(output.substring(i, j + 1));\n  }\n} catch (e) {\n  parsed = {};\n}\n\nconst message = parsed.message || \"Run is not eligible for Cursor execution\";\nconst reason = parsed.message || rawError || \"Validation returned an unparseable response\";\n\nreturn [{ json: {\n  status: \"failure\",\n  message: message,\n  runId: runId,\n  reason: reason,\n  runStatus: parsed.runStatus || \"\",\n  reviewStatus: parsed.reviewStatus || \"\",\n  runPath: parsed.runPath || \"\",\n  statusPath: parsed.statusPath || \"\"\n} }];"
      },
