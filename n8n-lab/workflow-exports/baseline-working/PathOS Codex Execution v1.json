    {
      "parameters": {
        "jsCode": "const raw = $('Execute Codex').item.json;\nconst stdout = typeof raw.stdout === 'string' ? raw.stdout.trim().replace(/^\\uFEFF/, '') : '';\nconst stderr = typeof raw.stderr === 'string' ? raw.stderr : '';\nconst runId = $('Normalize Packet').item.json.runId;\n\nlet parsed = null;\nfor (const line of stdout.split(/\\r?\\n/)) {\n  if (!line || !line.trim().startsWith('{')) continue;\n  try {\n    parsed = JSON.parse(line.trim());\n    break;\n  } catch {}\n}\n\nconst codexCompleted = stdout.includes(`CODEX_COMPLETED::${runId}`) && Number(raw.exitCode ?? 0) === 0;\nconst codexFailed = stdout.includes(`CODEX_FAILED::${runId}`) || Number(raw.exitCode ?? 0) !== 0;\n\nreturn [{\n  json: {\n    ...$('Read Current Status').item.json,\n    status: codexCompleted ? 'success' : 'failure',\n    message: parsed?.message ?? (codexCompleted ? 'Codex execution succeeded' : 'Codex execution failed'),\n    runId,\n    nextStatus: codexCompleted ? 'codex_review_complete' : 'codex_failed',\n    stdout,\n    stderr,\n    exitCode: String(raw.exitCode ?? ''),\n    execution: parsed,\n    codexCompleted,\n    codexFailed\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
