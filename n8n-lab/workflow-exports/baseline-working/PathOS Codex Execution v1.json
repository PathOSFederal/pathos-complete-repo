        "jsCode": "const body = $json.body ?? $json;\nconst runsRoot = body.runsRoot ?? 'C:\\\\dev\\\\PathOS\\\\n8n-lab\\\\runs';\nconst runId = body.runId ?? '';\n\nreturn [{\n  json: {\n    runId,\n    runsRoot,\n    runPath: body.runPath ?? `${runsRoot}\\\\${runId}`,\n    requestedAt: $now,\n    workflowName: 'PathOS Codex Execution v1'\n  }\n}];"
