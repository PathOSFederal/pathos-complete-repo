    {
      "parameters": {
        "jsCode": "const raw = $(\"Execute Codex Stage\").item.json;\nconst stdout = typeof raw.stdout === \"string\" ? raw.stdout.trim().replace(/^\\uFEFF/, \"\") : \"\";\nconst runId = $(\"Normalize Input\").item.json.runId;\n\nlet parsed = {\n  status: \"failure\",\n  message: \"Codex execution failed\",\n  runId,\n  reason: \"execute-codex-stage.ps1 returned an unparseable response.\",\n  stdout,\n  stderr: raw.stderr ?? \"\",\n  exitCode: String(raw.exitCode ?? \"\")\n};\n\nfor (const line of stdout.split(/\\r?\\n/)) {\n  if (!line || !line.trim().startsWith('{')) continue;\n  try {\n    parsed = JSON.parse(line.trim());\n    break;\n  } catch {}\n}\n\nreturn [{ json: parsed }];"
      },
