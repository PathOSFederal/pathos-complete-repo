      "parameters": {
        "jsCode": "const sourceRunId = $json.sourceRunId ?? $json.runId ?? \"\";\n\nconst revisionCommand =\n  `powershell.exe -ExecutionPolicy Bypass -File \"C:\\\\dev\\\\PathOS\\\\n8n-lab\\\\scripts\\\\create-revision-run.ps1\"` +\n  ` -RunId \"${sourceRunId}\"` +\n  ` -RunsRoot \"C:\\\\dev\\\\PathOS\\\\n8n-lab\\\\runs\"` +\n  ` -RevisionReason \"${$json.revisionReason ?? \"\"}\"` +\n  ` -ReviewFeedback \"${$json.reviewFeedback ?? \"\"}\"` +\n  ` -CarryForwardDesignReference \"${$json.carryForwardDesignReference ?? \"true\"}\"` +\n  ` -RevisionSummary \"${$json.revisionSummary ?? \"\"}\"` +\n  ` -RevisedNotes \"${$json.revisedNotes ?? \"\"}\"` +\n  ` -ReferenceImagePath \"${$json.referenceImagePath ?? \"\"}\"` +\n  ` -DesignNotesPath \"${$json.designNotesPath ?? \"\"}\"` +\n  ` -DesignSource \"${$json.designSource ?? \"\"}\"`;\n\nreturn [{ json: { ...$json, sourceRunId, revisionCommand } }];"
