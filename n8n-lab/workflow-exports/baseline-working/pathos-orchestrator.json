    },
    {
      "parameters": {
        "jsCode": "const raw = $(\"Execute Create Revision Run\").item.json;\nconst stdout = typeof raw.stdout === \"string\" ? raw.stdout.trim().replace(/^\\uFEFF/, \"\") : \"\";\nconst sourceRunId = $(\"Normalize Input\").item.json.sourceRunId ?? $(\"Normalize Input\").item.json.runId;\n\nlet parsed = {\n  status: \"failure\",\n  message: \"Revision run creation failed\",\n  reason: \"create-revision-run.ps1 returned an unparseable response.\",\n  runId: sourceRunId,\n  sourceRunId\n};\n\ntry {\n  if (stdout) {\n    parsed = JSON.parse(stdout);\n  }\n} catch (error) {\n  parsed = {\n    status: \"failure\",\n    message: \"Revision run creation failed\",\n    reason: error.message,\n    runId: sourceRunId,\n    sourceRunId,\n    rawStdout: stdout\n  };\n}\n\nif (parsed.status === \"success\" && parsed.revisionPacket) {\n  return [{ json: { ...parsed, ...parsed.revisionPacket } }];\n}\n\nreturn [{ json: parsed }];"
      },
