PATHOS_ENV=local
PATHOS_API_KEYS=local-dev-api-key-1234
PATHOS_BASE_URL=/api/v1
PATHOS_LOG_LEVEL=INFO
PATHOS_DB_PATH=data/pathos.db
DB_DIALECT=sqlite
DATABASE_URL=

USAJOBS_API_KEY=
USAJOBS_USER_AGENT=PathOSBackend/1.0 (local@example.com)
USAJOBS_API_BASE_URL=https://data.usajobs.gov
USAJOBS_HOST=data.usajobs.gov
USAJOBS_TIMEOUT_SECONDS=10
USAJOBS_CACHE_TTL_SECONDS=60

PATHOS_CORS_ORIGINS=
PATHOS_RATE_LIMIT_ENABLED=false
PATHOS_RATE_LIMIT_RPM=120

WORKER_ENABLED=true
ALERTS_EVALUATION_ENABLED=true
ALERTS_DELIVERY_ENABLED=true
DRY_RUN_MODE=false
PAUSE_REASON=
PATHOS_WORKER_INTERVAL_SECONDS=3600
PATHOS_WORKER_MAX_RUN_SECONDS=3500
PATHOS_WORKER_MAX_JOBS_SCANNED=500
PATHOS_WORKER_MAX_RULES_EVALUATED=50

ALERT_RULE_MIN_INTERVAL_MINUTES=60
ALERT_RUN_MAX_JOBS_SCANNED=500
ALERT_GLOBAL_RULES_PER_RUN=50
ALERT_RUN_LOCK_TTL_SECONDS=3900

RETENTION_DAYS_AUDIT=90
RETENTION_DAYS_DIGESTS=90
RETENTION_DAYS_THREAD_SUMMARIES=90
RETENTION_DAYS_UPSTREAM_RAW=90
TELEMETRY_ENABLED=false
