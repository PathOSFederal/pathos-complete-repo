+        canonical_job={**base_job, "title": "Senior Analyst"},
+        ingest_warnings=[],
+        seen_at="2026-02-20T00:05:00+00:00",
+    )
+    rows = SavedSearchIngestedJobRepo.list_by_saved_search(saved_search_id)
