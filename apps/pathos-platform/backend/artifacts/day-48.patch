+++            "close_date",
+++            "apply_url",
+++            "remote_status",
+++            "documents",
+++            "qualifications",
+++        ]
+++        changed: list[str] = []
+++        for field_name in comparable_fields:
+++            previous_value = previous_job.get(field_name)
+++            next_value = next_job.get(field_name)
+++            if previous_value != next_value:
+++                changed.append(field_name)
+++        return changed
