+          background: 'color-mix(in srgb, var(--p-success) 12%, transparent)',
+          color: 'var(--p-success)',
+        }}>
+          Adds facts, context
+        </span>
+        <span className="text-[10px] px-1.5 py-0.5 rounded" style={{
+          background: 'color-mix(in srgb, var(--p-success) 12%, transparent)',
+          color: 'var(--p-success)',
+        }}>
+          span five scope
+        </span>
+        <span className="text-[10px] px-1.5 py-0.5 rounded" style={{
